# ============================================================
# Agnes AI 免费全模态 API（OpenAI 兼容）配置
# ------------------------------------------------------------
# 注册获取免费 API Key：https://platform.agnes-ai.com
#   Settings -> API Keys -> Create new secret key
#
# Base URL（按需选择节点）：
#   国际主节点:   https://apihub.agnes-ai.com/v1
#   国际备用线路: https://apihub.agnes-ai.cn/v1
#   国内服务节点: https://api.agnes-ai.cn/v1  （需在国内站注册获取 Key）
# ------------------------------------------------------------
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_API_KEY="YOUR_AGNES_API_KEY"

# 识图模型（照片 -> 色号/台词/情绪DNA），当前免费
AGNES_VISION_MODEL="agnes-2.5-flash"

# 生图模型（AI 重绘电影海报），当前免费
AGNES_IMAGE_MODEL="agnes-image-2.1-flash"

# ============================================================
# 微信小程序登录（wx.login -> jscode2session）
# ------------------------------------------------------------
# AppID: 公众平台「开发管理 -> 开发设置」可见
# Secret: 公众平台「开发管理 -> 开发设置 -> 小程序密钥」（生成后仅显示一次）
# 均为敏感信息，只放服务端环境变量，绝不入库/进前端/进代码仓库
# ------------------------------------------------------------
WX_APPID="wxcf4f812d0feb5ae8"
WX_SECRET="YOUR_WX_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
