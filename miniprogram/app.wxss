/** app.wxss 全局样式 **/
page {
  background-color: #0c0a09;
  color: #f5f5f4;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, image, button, input, textarea {
  box-sizing: border-box;
}

/* 优雅字重与通用类 */
.font-serif {
  font-family: "Songti SC", "SimSun", "STSong", serif;
}

.font-mono {
  font-family: "SF Pro Text", "SF Mono", "Menlo", monospace;
}

/* 按钮重置与高定质感 */
button::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
  color: #0c0a09;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(245, 158, 11, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  background-color: #1c1917;
  color: #e7e5e4;
  border: 2rpx solid #292524;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 22rpx 36rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  background-color: #292524;
}

/* 卡片玻璃拟态 */
.glass-card {
  background: rgba(28, 25, 23, 0.85);
  border: 1rpx solid rgba(68, 64, 60, 0.6);
  border-radius: 36rpx;
  padding: 32rpx;
}

/* 标签通用 */
.badge-gold {
  background: rgba(245, 158, 11, 0.15);
  border: 1rpx solid rgba(245, 158, 11, 0.4);
  color: #fcd34d;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
}
