/** pages/pro/pro.wxss **/
.pro-container {
  padding: 30rpx 28rpx 60rpx;
  min-height: 100vh;
}

.vip-hero-card {
  background: linear-gradient(135deg, #1c1917 0%, #292524 100%);
  border: 2rpx solid #b45309;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 50rpx rgba(180, 83, 9, 0.15);
}

.vip-badge-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.vip-crown {
  font-size: 32rpx;
}

.vip-tag {
  font-size: 20rpx;
  color: #fbbf24;
  letter-spacing: 2rpx;
}

.vip-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #fef3c7;
  margin-bottom: 8rpx;
}

.vip-subtitle {
  font-size: 22rpx;
  color: #a8a29e;
  margin-bottom: 30rpx;
}

.vip-privilege-list {
  border-top: 1rpx solid rgba(120, 113, 108, 0.3);
  border-bottom: 1rpx solid rgba(120, 113, 108, 0.3);
  padding: 24rpx 0;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.priv-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  color: #f5f5f4;
}

.priv-icon {
  font-size: 26rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-left {
  display: flex;
  align-items: baseline;
}

.currency {
  color: #f59e0b;
  font-size: 28rpx;
  font-weight: 700;
}

.amount {
  color: #f59e0b;
  font-size: 48rpx;
  font-weight: 900;
  margin: 0 8rpx 0 4rpx;
}

.original {
  font-size: 22rpx;
  color: #78716c;
  text-decoration: line-through;
}

.buy-btn {
  font-size: 26rpx;
  padding: 18rpx 36rpx;
}

/* POD 列表 */
.pod-section {
  margin-top: 20rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fafaf9;
}

.section-badge {
  font-size: 20rpx;
  color: #34d399;
  background: rgba(52, 211, 153, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.pod-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pod-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.pod-icon-box {
  width: 90rpx;
  height: 90rpx;
  background: #292524;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.pod-info {
  flex: 1;
}

.pod-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #fafaf9;
}

.pod-desc {
  font-size: 20rpx;
  color: #a8a29e;
  margin: 6rpx 0;
}

.pod-price {
  font-size: 24rpx;
  font-weight: 700;
  color: #f59e0b;
}

.mini-order-btn {
  font-size: 22rpx;
  padding: 10rpx 24rpx;
}
