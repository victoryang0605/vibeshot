/** pages/studio/studio.wxss **/
.studio-container {
  padding: 20rpx 24rpx 220rpx;
  min-height: 100vh;
}

.template-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.template-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #1c1917;
  border: 1rpx solid #292524;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #a8a29e;
}

.tab-active {
  background: #f59e0b;
  color: #0c0a09;
  font-weight: 700;
  border-color: #f59e0b;
}

.tab-icon {
  font-size: 28rpx;
}

/* 卡片舞台区 */
.card-stage-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

/* 1. 拍立得样式 */
.polaroid-card {
  width: 620rpx;
  background: #fcfbf9;
  color: #1c1917;
  padding: 24rpx 24rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.6);
}

.polaroid-image-frame {
  width: 100%;
  height: 572rpx;
  background-color: #000;
  position: relative;
  overflow: hidden;
  border-radius: 6rpx;
}

.main-photo {
  width: 100%;
  height: 100%;
}

.film-date-stamp {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  color: #ea580c;
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.4);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.polaroid-bottom {
  padding-top: 24rpx;
}

.swatch-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.swatch-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
}

.swatch-code {
  font-size: 20rpx;
  color: #78716c;
  margin-left: 8rpx;
}

.polaroid-quote {
  font-size: 28rpx;
  line-height: 1.6;
  color: #292524;
  margin-bottom: 12rpx;
}

.polaroid-sub-quote {
  font-size: 20rpx;
  color: #78716c;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.polaroid-footer-row {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx dashed #d6d3d1;
  padding-top: 16rpx;
  font-size: 18rpx;
  color: #a8a29e;
}

/* 2. 黑胶唱片样式 */
.vinyl-card {
  width: 620rpx;
  background: #18181b;
  color: #fafafa;
  padding: 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid #27272a;
}

.vinyl-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 20rpx;
  color: #fbbf24;
}

.vinyl-disc-mini {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #3f3f46;
  border: 4rpx solid #71717a;
}

.vinyl-cover-wrapper {
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.vinyl-meta {
  margin-top: 24rpx;
}

.track-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.track-artist {
  font-size: 22rpx;
  color: #a1a1aa;
  margin-top: 6rpx;
}

.vinyl-lyrics {
  font-size: 26rpx;
  line-height: 1.6;
  color: #e4e4e7;
  margin: 20rpx 0;
  font-style: italic;
}

.vinyl-color-strip {
  display: flex;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
}

.strip-block {
  height: 100%;
}

/* 3. 杂志风 */
.magazine-card {
  width: 620rpx;
  background: #fdfbf7;
  color: #1c1917;
  padding: 36rpx 28rpx;
  border-radius: 12rpx;
}

.mag-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-bottom: 2rpx solid #1c1917;
  padding-bottom: 12rpx;
  margin-bottom: 20rpx;
}

.mag-logo {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.mag-sub {
  font-size: 18rpx;
  color: #57534e;
}

.mag-photo-box {
  width: 100%;
  height: 440rpx;
  position: relative;
  overflow: hidden;
}

.mag-headline {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.6);
}

.mag-body {
  margin-top: 24rpx;
}

.mag-editorial {
  font-size: 26rpx;
  line-height: 1.7;
  color: #292524;
  margin-bottom: 20rpx;
}

.mag-cmyk-list {
  font-size: 18rpx;
  color: #78716c;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mag-cmyk-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.color-badge {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
}

/* 4. 宽银幕电影 */
.cinema-card {
  width: 650rpx;
  background: #000;
  color: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  overflow: hidden;
}

.cinema-top-bar, .cinema-bottom-bar {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 24rpx;
  font-size: 18rpx;
  color: #71717a;
}

.rec-dot {
  color: #ef4444;
}

.cinema-frame {
  width: 100%;
  height: 380rpx;
  position: relative;
}

.cinema-subtitle-box {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  padding: 0 24rpx;
}

.cinema-chinese {
  font-size: 26rpx;
  color: #fef08a;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.9);
}

.cinema-english {
  font-size: 18rpx;
  color: #e4e4e7;
  margin-top: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.9);
}

/* 5. 潘通色卡 */
.pantone-card {
  width: 620rpx;
  background: #fff;
  color: #000;
  border-radius: 20rpx;
  padding: 24rpx;
}

.pantone-photo {
  width: 100%;
  height: 480rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.pantone-info {
  margin-top: 24rpx;
}

.pantone-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #71717a;
}

.pantone-color-name {
  font-size: 32rpx;
  font-weight: 700;
  margin: 6rpx 0;
}

.pantone-codes {
  display: flex;
  gap: 20rpx;
  font-size: 20rpx;
  color: #71717a;
  margin-bottom: 16rpx;
}

.pantone-quote {
  font-size: 24rpx;
  line-height: 1.6;
  color: #27272a;
}

/* 控制面板 */
.control-panel {
  margin-bottom: 24rpx;
}

.panel-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f5f5f4;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.filter-title {
  margin-top: 28rpx;
}

.quote-style-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.quote-chip {
  background: #292524;
  border: 1rpx solid #44403c;
  color: #d6d3d1;
  font-size: 22rpx;
  padding: 16rpx 14rpx;
  border-radius: 18rpx;
  text-align: center;
}

.chip-active {
  background: rgba(245, 158, 11, 0.2);
  border-color: #f59e0b;
  color: #fbbf24;
  font-weight: 700;
}

.custom-edit-box {
  margin-top: 20rpx;
}

.edit-label {
  font-size: 22rpx;
  color: #a8a29e;
  margin-bottom: 8rpx;
}

.quote-textarea {
  width: 100%;
  height: 130rpx;
  background-color: #0c0a09;
  border: 1rpx solid #44403c;
  border-radius: 16rpx;
  padding: 14rpx;
  font-size: 24rpx;
  color: #f5f5f4;
  line-height: 1.5;
}

.filter-scroll {
  display: flex;
  white-space: nowrap;
}

.filter-tab {
  display: inline-block;
  background: #292524;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: #a8a29e;
  margin-right: 14rpx;
}

.filter-active {
  background: #f59e0b;
  color: #000;
  font-weight: 700;
}

/* 滤镜模拟 */
.filter-grain {
  filter: contrast(1.1) brightness(0.95);
}
.filter-warm {
  filter: sepia(0.25) saturate(1.2);
}
.filter-cold {
  filter: hue-rotate(180deg) saturate(0.8);
}
.filter-cyber {
  filter: saturate(1.8) contrast(1.2);
}
.filter-bw {
  filter: grayscale(1);
}

/* DNA 面板 */
.dna-panel {
  margin-bottom: 24rpx;
}

.dna-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dna-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #fafaf9;
}

.dna-badge {
  font-size: 20rpx;
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.dna-row {
  font-size: 22rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
  display: flex;
}

.dna-label {
  color: #a8a29e;
  width: 140rpx;
  flex-shrink: 0;
}

.dna-val {
  color: #e7e5e4;
}

/* 吸底操作 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(12, 10, 9, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #292524;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  z-index: 100;
}

.copy-btn {
  flex: 1;
}

.btn-ai-redraw {
  flex: 1.2;
  background: linear-gradient(135deg, #7c3aed, #c026d3, #db2777);
  color: #ffffff;
  font-weight: 700;
  font-size: 26rpx;
  border-radius: 30rpx;
  padding: 0 12rpx;
  border: none;
  line-height: 2.6;
}

.btn-ai-redraw[disabled] {
  opacity: 0.6;
  color: #ffffff;
  background: linear-gradient(135deg, #6d28d9, #a21caf, #be185d);
}

.export-btn {
  flex: 2;
}

/* AI 重绘海报预览区 */
.ai-poster-panel {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.ai-poster-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ai-poster-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0abfc;
}

.ai-poster-badge {
  font-size: 18rpx;
  color: #a78bfa;
  background: rgba(124, 58, 237, 0.15);
  border: 1rpx solid rgba(167, 139, 250, 0.35);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.ai-poster-image {
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  background: #0c0a09;
}

.btn-ai-save {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #0c0a09;
  font-weight: 700;
  font-size: 28rpx;
  border-radius: 30rpx;
  border: none;
}
