<!-- pages/me/me.wxml -->
<view class="me-container">

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <block wx:if="{{isLoggedIn}}">
      <view class="avatar-circle">
        <text class="avatar-text">{{userInitial}}</text>
      </view>
      <view class="user-info">
        <view class="user-nickname">{{user.nickName || '微信用户'}}</view>
        <view class="user-openid font-mono">ID: {{openidShort}}</view>
      </view>
      <view class="logout-btn" bindtap="handleLogout">退出</view>
    </block>

    <block wx:else>
      <view class="avatar-circle guest">
        <text class="avatar-text">👋</text>
      </view>
      <view class="user-info">
        <view class="user-nickname">未登录</view>
        <view class="user-openid">登录后保存你的情绪作品与偏好</view>
      </view>
      <view class="login-btn" bindtap="handleLogin">微信一键登录</view>
    </block>
  </view>

  <!-- 昵称编辑（已登录） -->
  <view wx:if="{{isLoggedIn}}" class="edit-panel">
    <view class="edit-label">昵称</view>
    <input
      class="nickname-input"
      type="nickname"
      placeholder="输入昵称"
      value="{{nickNameDraft}}"
      bindinput="onNicknameInput"
    />
    <button class="save-btn" bindtap="saveNickname" disabled="{{!nickNameDraft}}">保存昵称</button>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goPro">
      <text class="menu-icon">👑</text>
      <text class="menu-text">Pro 会员与实体文创</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCreate">
      <text class="menu-icon">📷</text>
      <text class="menu-text">去创作</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="shareApp">
      <button class="share-btn" open-type="share">
        <text class="menu-icon">💌</text>
        <text class="menu-text">分享给好友</text>
        <text class="menu-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="version-text font-mono">拾光半格 · v1.0.0</view>

</view>
