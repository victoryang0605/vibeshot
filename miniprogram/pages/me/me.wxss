/** pages/me/me.wxss **/
.me-container {
  padding: 40rpx 32rpx 60rpx;
  min-height: 100vh;
  background: #0c0a09;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #1c1917, #292524);
  border: 1rpx solid #3f3a36;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.avatar-circle.guest {
  background: #44403c;
  box-shadow: none;
}

.avatar-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #0c0a09;
}

.avatar-circle.guest .avatar-text {
  color: #a8a29e;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #f5f5f4;
  font-family: serif;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-openid {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 8rpx;
}

.logout-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  border: 1rpx solid #57534e;
  color: #a8a29e;
  font-size: 24rpx;
  flex-shrink: 0;
}

.login-btn {
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #0c0a09;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 昵称编辑 */
.edit-panel {
  margin-top: 24rpx;
  background: #1c1917;
  border: 1rpx solid #292524;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-label {
  font-size: 26rpx;
  color: #a8a29e;
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  background: #0c0a09;
  border: 1rpx solid #44403c;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  color: #f5f5f4;
  font-size: 26rpx;
}

.save-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 10rpx 28rpx;
  background: #f59e0b;
  color: #0c0a09;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 30rpx;
  line-height: 1.8;
}

.save-btn[disabled] {
  opacity: 0.4;
  color: #0c0a09;
  background: #78716c;
}

/* 功能列表 */
.menu-list {
  margin-top: 32rpx;
  background: #1c1917;
  border: 1rpx solid #292524;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #292524;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 30rpx;
  margin-right: 18rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #e7e5e4;
}

.menu-arrow {
  color: #57534e;
  font-size: 32rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  text-align: left;
}

.share-btn::after {
  border: none;
}

.version-text {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: #57534e;
}
