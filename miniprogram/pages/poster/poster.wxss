/** pages/poster/poster.wxss **/
.poster-page {
  padding: 30rpx 28rpx 80rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.preview-tip {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 12rpx;
}

.canvas-box {
  position: absolute;
  left: -9999px;
  top: -9999px;
}

.poster-canvas {
  width: 750px;
  height: 1100px;
}

.image-preview-wrapper {
  width: 600rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8);
  margin-bottom: 40rpx;
}

.poster-rendered-img {
  width: 100%;
  display: block;
}

.poster-action-group {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.full-btn {
  width: 100%;
}

.back-link-btn {
  background: transparent;
  color: #78716c;
  font-size: 24rpx;
  margin-top: 10rpx;
}
